# STEP 5: Create formatted table with significance stars

format_dm <- function(dm_stat, p_val) {
  if (is.na(dm_stat)) return("—")
  
  sig <- ""
  if (p_val < 0.01) sig <- "***"
  else if (p_val < 0.05) sig <- "**"
  else if (p_val < 0.10) sig <- "*"
  
  return(paste0(sprintf("%.2f", dm_stat), sig))
}

dm_formatted <- matrix(NA, nrow = 4, ncol = 12)
for (i in 1:4) {
  for (j in 1:12) {
    dm_formatted[i, j] <- format_dm(dm_results[i, j], p_results[i, j])
  }
}
